{
  // CelesteApp: visor climático de Costa Rica (Cloudflare Worker + archivos estáticos)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celesteapp",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
